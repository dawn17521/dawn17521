# Copy this file to .env and adjust the values.

# SQLite database location (Prisma)
DATABASE_URL="file:./dev.db"

# Secret used to sign auth JWTs. Use a long random string in production.
JWT_SECRET="change-me-to-a-long-random-secret"

# Set to "false" if you are temporarily serving over plain HTTP (e.g. accessing
# the server by its IP before HTTPS/DNS is configured), otherwise login cookies
# will not be sent. Set back to "true" (or leave blank in production) once you
# have HTTPS so the auth cookie is only sent over secure connections.
COOKIE_SECURE=""

# --- Payment providers (leave blank to keep the built-in sandbox/mock flow) ---
# When you obtain real merchant credentials, fill these in and wire them up in
# src/lib/payments.ts. Until then the app simulates successful payments.
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
WECHAT_PAY_MCH_ID=""
WECHAT_PAY_API_KEY=""
ALIPAY_APP_ID=""
ALIPAY_PRIVATE_KEY=""

# Pricing
PRICE_PER_HOUR="50"
CURRENCY="CNY"
